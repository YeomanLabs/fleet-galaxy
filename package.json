{
  "name": "fleet-galaxy",
  "version": "2.0.0",
  "description": "Your Intune-managed Windows fleet as a living 3D galaxy.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "capture": "node scripts/capture.mjs && python scripts/make-gif.py",
    "build:electron": "node scripts/build-electron.mjs",
    "desktop": "vite build && node scripts/build-electron.mjs && electron .",
    "dist:win": "npm run build && node scripts/build-electron.mjs && electron-builder --win",
    "dist:mac": "npm run build && node scripts/build-electron.mjs && electron-builder --mac"
  },
  "author": "YeomanLabs",
  "license": "MIT",
  "dependencies": {
    "@azure/msal-node": "^7.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs"
}
